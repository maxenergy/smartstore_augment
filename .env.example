# ========================================
# 跨境电商分销系统 - 环境变量配置模板
# ========================================
# 复制此文件为 .env.local 并填入实际值

# ========================================
# 应用配置
# ========================================
# 应用环境: development | production | test
NODE_ENV=development

# 应用URL (生产环境需要修改)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API基础路径
NEXT_PUBLIC_API_BASE_URL=/api/v1

# ========================================
# 数据库配置
# ========================================
# SQLite (开发环境)
DATABASE_URL="file:./dev.db"

# PostgreSQL (生产环境示例 - 取消注释并填入实际值)
# DATABASE_URL="postgresql://username:password@localhost:5432/smartstore?schema=public"

# ========================================
# NextAuth.js 认证配置
# ========================================
# NextAuth Secret (生产环境必须修改!)
# 生成方法: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# NextAuth URL
NEXTAUTH_URL=http://localhost:3000

# JWT 过期时间 (秒)
JWT_EXPIRATION=2592000

# ========================================
# 第三方平台 API 配置
# ========================================

# Amazon Product Advertising API 5.0
AMAZON_ACCESS_KEY=your-amazon-access-key
AMAZON_SECRET_KEY=your-amazon-secret-key
AMAZON_PARTNER_TAG=your-amazon-associate-tag
AMAZON_MARKETPLACE=www.amazon.com
AMAZON_REGION=us-east-1

# TikTok Shop API
TIKTOK_APP_KEY=your-tiktok-app-key
TIKTOK_APP_SECRET=your-tiktok-app-secret
TIKTOK_ACCESS_TOKEN=your-tiktok-access-token
TIKTOK_SHOP_ID=your-tiktok-shop-id

# Shopify API
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret
SHOPIFY_ACCESS_TOKEN=your-shopify-access-token
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com

# eBay API
EBAY_CLIENT_ID=your-ebay-client-id
EBAY_CLIENT_SECRET=your-ebay-client-secret
EBAY_REFRESH_TOKEN=your-ebay-refresh-token
EBAY_ENVIRONMENT=SANDBOX

# ========================================
# Redis 配置 (可选 - 用于缓存和会话)
# ========================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ========================================
# 文件存储配置
# ========================================
# 本地存储路径
UPLOAD_DIR=./public/uploads

# AWS S3 (可选 - 用于生产环境)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# ========================================
# 邮件服务配置 (可选)
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@smartstore.com

# ========================================
# 日志配置
# ========================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# ========================================
# 安全配置
# ========================================
# CORS 允许的源 (逗号分隔)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# API 速率限制 (请求/分钟)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ========================================
# 功能开关
# ========================================
ENABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=false
ENABLE_TWO_FACTOR_AUTH=false

# ========================================
# 开发工具
# ========================================
# 启用调试模式
DEBUG=false

# 启用 API 文档
ENABLE_API_DOCS=true

