// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// 枚举类型定义
// ============================================

/// 用户角色枚举
enum UserRole {
  ADMIN // 管理员 - 拥有系统最高权限
  MERCHANT // 商家 - 普通商家用户
  API_USER // API用户 - 仅通过API访问的用户
}

/// 用户状态枚举
enum UserStatus {
  ACTIVE // 活跃 - 正常使用中
  INACTIVE // 未激活 - 注册后未激活邮箱
  SUSPENDED // 已暂停 - 账号被管理员暂停
}

/// 平台枚举
enum Platform {
  AMAZON // 亚马逊
  TIKTOK // TikTok Shop
  SHOPIFY // Shopify
  EBAY // eBay
}

/// 店铺状态枚举
enum ShopStatus {
  ACTIVE // 活跃 - 正常使用中
  INACTIVE // 未激活 - 店铺未激活
  EXPIRED // 已过期 - 授权令牌已过期
}

/// 产品状态枚举
enum ProductStatus {
  ACTIVE // 活跃 - 正常使用中
  INACTIVE // 未激活 - 产品未激活
  DELETED // 已删除 - 产品已删除
}

// ============================================
// 数据模型定义
// ============================================

/// 用户表模型
/// 存储系统用户的基本信息、认证信息和状态
model User {
  id            String     @id @default(cuid())
  email         String     @unique
  password      String // bcrypt 加密后的密码
  name          String? // 用户姓名（可选）
  role          UserRole   @default(MERCHANT)
  status        UserStatus @default(ACTIVE)
  emailVerified DateTime? // 邮箱验证时间
  image         String? // 用户头像URL（可选）
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // 关系字段
  shops    Shop[]
  products Product[]
  // orders        Order[]

  @@map("users")
}

/// 店铺表模型
/// 存储用户在各个电商平台的店铺信息和授权令牌
model Shop {
  id             String     @id @default(cuid())
  userId         String
  platform       Platform
  shopName       String // 店铺名称
  shopId         String // 平台店铺ID
  accessToken    String // 平台访问令牌
  refreshToken   String? // 平台刷新令牌（可选）
  tokenExpiresAt DateTime? // 令牌过期时间（可选）
  status         ShopStatus @default(ACTIVE)
  config         String? // JSON格式的店铺配置（可选）
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // 关系字段
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // platformProducts PlatformProduct[]
  // orders           Order[]

  // 索引和约束
  @@unique([userId, platform, shopId]) // 防止重复添加同一店铺
  @@index([userId]) // 优化用户店铺查询
  @@map("shops")
}

/// 产品表模型
/// 存储从各个平台导入的产品信息
model Product {
  id              String        @id @default(cuid())
  userId          String
  sourcePlatform  Platform // 产品来源平台
  sourceProductId String // 源平台产品ID
  title           String // 产品标题
  description     String? // 产品描述（可选）
  price           Float // 产品价格
  currency        String        @default("USD") // 货币代码（如 USD, CNY）
  images          String // JSON数组格式的图片URL列表
  specifications  String? // JSON格式的产品规格（可选）
  category        String? // 产品分类（可选）
  tags            String? // JSON数组格式的标签列表（可选）
  rating          Float? // 产品评分（可选）
  reviewCount     Int? // 评论数量（可选）
  status          ProductStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // 关系字段
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // platformProducts PlatformProduct[]

  // 索引和约束
  @@unique([sourcePlatform, sourceProductId]) // 防止重复导入同一产品
  @@index([userId]) // 优化用户产品查询
  @@index([status]) // 优化状态筛选
  @@map("products")
}
