// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// 枚举类型定义
// ============================================

/// 用户角色枚举
enum UserRole {
  ADMIN // 管理员 - 拥有系统最高权限
  MERCHANT // 商家 - 普通商家用户
  API_USER // API用户 - 仅通过API访问的用户
}

/// 用户状态枚举
enum UserStatus {
  ACTIVE // 活跃 - 正常使用中
  INACTIVE // 未激活 - 注册后未激活邮箱
  SUSPENDED // 已暂停 - 账号被管理员暂停
}

/// 平台枚举
enum Platform {
  AMAZON // 亚马逊
  TIKTOK // TikTok Shop
  SHOPIFY // Shopify
  EBAY // eBay
}

/// 店铺状态枚举
enum ShopStatus {
  ACTIVE // 活跃 - 正常使用中
  INACTIVE // 未激活 - 店铺未激活
  EXPIRED // 已过期 - 授权令牌已过期
}

/// 产品状态枚举
enum ProductStatus {
  ACTIVE // 活跃 - 正常使用中
  INACTIVE // 未激活 - 产品未激活
  DELETED // 已删除 - 产品已删除
}

/// 平台产品状态枚举
enum PlatformProductStatus {
  ACTIVE // 活跃 - 正常销售中
  INACTIVE // 未激活 - 未上架
  OUT_OF_STOCK // 缺货 - 库存不足
}

/// 订单状态枚举
enum OrderStatus {
  PENDING // 待支付 - 订单已创建，等待支付
  PAID // 已支付 - 订单已支付
  SHIPPED // 已发货 - 订单已发货
  DELIVERED // 已送达 - 订单已送达
  CANCELLED // 已取消 - 订单已取消
  REFUNDED // 已退款 - 订单已退款
}

// ============================================
// 数据模型定义
// ============================================

/// 用户表模型
/// 存储系统用户的基本信息、认证信息和状态
model User {
  id            String     @id @default(cuid())
  email         String     @unique
  password      String // bcrypt 加密后的密码
  name          String? // 用户姓名（可选）
  role          UserRole   @default(MERCHANT)
  status        UserStatus @default(ACTIVE)
  emailVerified DateTime? // 邮箱验证时间
  image         String? // 用户头像URL（可选）
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // 关系字段
  shops    Shop[]
  products Product[]
  orders   Order[]
  syncLogs SyncLog[]

  @@map("users")
}

/// 店铺表模型
/// 存储用户在各个电商平台的店铺信息和授权令牌
model Shop {
  id             String     @id @default(cuid())
  userId         String
  platform       Platform
  shopName       String // 店铺名称
  shopId         String // 平台店铺ID
  accessToken    String // 平台访问令牌
  refreshToken   String? // 平台刷新令牌（可选）
  tokenExpiresAt DateTime? // 令牌过期时间（可选）
  status         ShopStatus @default(ACTIVE)
  config         String? // JSON格式的店铺配置（可选）
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // 关系字段
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformProducts PlatformProduct[]
  orders           Order[]

  // 索引和约束
  @@unique([userId, platform, shopId]) // 防止重复添加同一店铺
  @@index([userId]) // 优化用户店铺查询
  @@map("shops")
}

/// 产品表模型
/// 存储从各个平台导入的产品信息
model Product {
  id              String        @id @default(cuid())
  userId          String
  sourcePlatform  Platform // 产品来源平台
  sourceProductId String // 源平台产品ID
  title           String // 产品标题
  description     String? // 产品描述（可选）
  price           Float // 产品价格
  currency        String        @default("USD") // 货币代码（如 USD, CNY）
  images          String // JSON数组格式的图片URL列表
  specifications  String? // JSON格式的产品规格（可选）
  category        String? // 产品分类（可选）
  tags            String? // JSON数组格式的标签列表（可选）
  rating          Float? // 产品评分（可选）
  reviewCount     Int? // 评论数量（可选）
  status          ProductStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // 关系字段
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformProducts PlatformProduct[]

  // 索引和约束
  @@unique([sourcePlatform, sourceProductId]) // 防止重复导入同一产品
  @@index([userId]) // 优化用户产品查询
  @@index([status]) // 优化状态筛选
  @@map("products")
}

/// 平台产品关联表模型
/// 存储产品在各个店铺的销售信息（价格、库存、状态等）
model PlatformProduct {
  id                String                @id @default(cuid())
  productId         String
  shopId            String
  platformProductId String // 平台上的产品ID
  platform          Platform // 销售平台
  price             Float // 在该平台的销售价格
  inventory         Int // 库存数量
  status            PlatformProductStatus @default(ACTIVE)
  syncedAt          DateTime? // 最后同步时间（可选）
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  // 关系字段
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // 索引和约束
  @@unique([productId, shopId]) // 防止同一产品在同一店铺重复添加
  @@index([productId]) // 优化产品关联查询
  @@index([shopId]) // 优化店铺产品查询
  @@index([status]) // 优化状态筛选
  @@map("platform_products")
}

/// 订单表模型
/// 存储来自各个平台的订单信息
model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique // 订单编号（唯一）
  userId          String
  shopId          String
  platform        Platform // 订单来源平台
  totalAmount     Float // 订单总金额
  currency        String      @default("USD") // 货币代码（如 USD, CNY）
  status          OrderStatus @default(PENDING)
  customerName    String // 客户姓名
  customerEmail   String? // 客户邮箱（可选）
  customerPhone   String? // 客户电话（可选）
  shippingAddress String // JSON格式的收货地址
  items           String // JSON数组格式的订单项列表
  notes           String? // 订单备注（可选）
  paidAt          DateTime? // 支付时间（可选）
  shippedAt       DateTime? // 发货时间（可选）
  deliveredAt     DateTime? // 送达时间（可选）
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // 关系字段
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // 索引和约束
  @@index([userId]) // 优化用户订单查询
  @@index([shopId]) // 优化店铺订单查询
  @@index([status]) // 优化状态筛选
  @@index([createdAt]) // 优化时间排序
  @@map("orders")
}

/// 同步日志表模型
/// 记录数据同步操作的历史
model SyncLog {
  id         String   @id @default(cuid())
  syncType   String // 同步类型：INVENTORY, PRICE, ORDER
  entityType String // 实体类型：PRODUCT, PLATFORM_PRODUCT, ORDER
  entityId   String // 实体ID
  status     String // 同步状态：SUCCESS, FAILED, PENDING
  message    String? // 同步消息或错误信息
  userId     String // 操作用户ID
  syncedAt   DateTime @default(now())

  // 关系字段
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 索引
  @@index([userId])
  @@index([syncType])
  @@index([status])
  @@index([syncedAt])
  @@map("sync_logs")
}
